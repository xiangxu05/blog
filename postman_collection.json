{
  "info": {
    "name": "Personal Blog API",
    "description": "个人博客系统API接口集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "用户模块",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"password123\",\n    \"confirm_password\": \"password123\",\n    \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            }
          }
        },
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          }
        },
        {
          "name": "用户注销",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "logout"]
            }
          }
        },
        {
          "name": "删除用户",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/delete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "delete"]
            }
          }
        },
        {
          "name": "刷新登出时间",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "refresh"]
            }
          }
        },
        {
          "name": "获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "更新用户信息",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nickname\": \"新昵称\",\n    \"email\": \"newemail@example.com\",\n    \"avatar\": \"avatar_url\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "修改密码",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"old_password\": \"password123\",\n    \"new_password\": \"newpassword123\",\n    \"confirm_password\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "password"]
            }
          }
        },
        {
          "name": "获取其他用户公开信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "文件模块",
      "item": [
        {
          "name": "上传文件",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload", ""]
            }
          }
        },
        {
          "name": "获取所有文件信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", ""]
            }
          }
        },
        {
          "name": "获取文件信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/file_id_here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "file_id_here"]
            }
          }
        },
        {
          "name": "下载文件",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/download/file_id_here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "download", "file_id_here"]
            }
          }
        },
        {
          "name": "删除文件",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/file_id_here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "file_id_here"]
            }
          }
        }
      ]
    },
    {
      "name": "文章模块",
      "item": [
        {
          "name": "获取单个文章",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "1"]
            }
          }
        },
        {
          "name": "获取文章列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles?page=1&page_size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "创建文章",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"文章标题\",\n    \"description\": \"文章描述\",\n    \"store_id\": 1,\n    \"catagorys\": \"技术\",\n    \"tags\": \"Go,Web开发\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles"]
            }
          }
        },
        {
          "name": "更新文章",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"更新后的文章标题\",\n    \"description\": \"更新后的文章描述\",\n    \"store_id\": 1,\n    \"catagorys\": \"技术\",\n    \"tags\": \"Go,Web开发,更新\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/articles/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "1"]
            }
          }
        },
        {
          "name": "删除文章",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/articles/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "articles", "1"]
            }
          }
        }
      ]
    }
  ]
}